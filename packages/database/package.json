{
  "name": "@repo/database",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "check-db": "tsx src/check-connection.ts",
    "check-repository": "tsx src/check-repository.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@repo/typescript-config": "workspace:*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prisma": "6.19.3",
    "tsx": "^4.23.12"
  }
}